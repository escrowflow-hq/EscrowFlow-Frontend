NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_USE_MOCK=true

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add http://localhost:3000 as an authorized JavaScript
# origin to test locally; add your production origin before deploying.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Apple Developer -> Certificates, IDs & Profiles -> Identifiers -> Services ID
# with "Sign in with Apple" enabled. Apple requires a verified HTTPS domain and
# rejects localhost outright, so these only work once deployed.
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# Stellar network ("testnet" | "futurenet" | "mainnet") and the Soroban
# contract IDs escrow/deposit funds flow through once mocks are replaced.
# Required in production once NEXT_PUBLIC_USE_MOCK=false.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_CONTRACT_ID=
NEXT_PUBLIC_USDC_CONTRACT_ID=

# Optional analytics / error tracking.
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Feature flags.
NEXT_PUBLIC_FEATURE_KYC=false
NEXT_PUBLIC_FEATURE_MESSAGING=false

# Surfaced in UI/error reports; bump on release.
NEXT_PUBLIC_APP_VERSION=0.1.0
